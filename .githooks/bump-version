#!/usr/bin/env bash
# bump-version <git log revision args> — bump plugins/igr/.claude-plugin/plugin.json by the
# strongest conventional-commit type among those commits; prints "<version> (<type>)".
# Shared by post-commit (one commit) and post-merge (the landed range).
#   feat!: / BREAKING CHANGE  -> major
#   feat:                     -> minor
#   anything else             -> patch
set -euo pipefail

subjects=$(git log --format=%s "$@")
bodies=$(git log --format=%B "$@")
bump=patch
if grep -qE '^[a-zA-Z]+(\([^)]*\))?!:' <<<"$subjects" || grep -q 'BREAKING CHANGE' <<<"$bodies"; then
  bump=major
elif grep -qE '^feat(\([^)]*\))?:' <<<"$subjects"; then
  bump=minor
fi

BUMP=$bump python3 - <<'EOF'
import json, os
p = "plugins/igr/.claude-plugin/plugin.json"
d = json.load(open(p))
ma, mi, pa = (int(x) for x in d["version"].split("."))
b = os.environ["BUMP"]
if b == "major": ma, mi, pa = ma + 1, 0, 0
elif b == "minor": mi, pa = mi + 1, 0
else: pa += 1
d["version"] = f"{ma}.{mi}.{pa}"
with open(p, "w") as f:
    json.dump(d, f, indent=2)
    f.write("\n")
print(f"{d['version']} ({b})")
EOF
