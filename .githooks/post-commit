#!/usr/bin/env bash
# post-commit — on main only, auto-bump .claude-plugin/plugin.json from the
# conventional-commit type (see bump-version), then amend the bump into HEAD (a
# commit-msg/pre-commit hook cannot: content staged in commit-msg lands in the NEXT
# commit — verified). Branch and worktree commits never bump; they bump once when they
# land on main (post-merge, or this hook for a squash commit).
# Bumps when the commit ships plugin content (anything under plugins/igr/).
# Skips: version already moved in HEAD (manual bump — and the recursion guard for the
# amend below); rebase/cherry-pick/merge replays; uncommitted plugin.json edits.
# Bypass: IGR_NO_BUMP=1 git commit …
# One-time setup after clone: ./setup.sh  (= git config core.hooksPath .githooks)
set -euo pipefail
PLUGIN=plugins/igr/.claude-plugin/plugin.json

if [[ "${IGR_NO_BUMP:-}" == "1" ]]; then exit 0; fi
if [[ $(git branch --show-current) != main ]]; then exit 0; fi
if ! git rev-parse -q --verify HEAD^ >/dev/null 2>&1; then exit 0; fi   # initial commit

g=$(git rev-parse --git-dir)
if [[ -d $g/rebase-merge || -d $g/rebase-apply || -f $g/CHERRY_PICK_HEAD || -f $g/MERGE_HEAD ]]; then
  exit 0   # replayed commits carry their own bumps
fi

if ! git diff-tree --no-commit-id --name-only -r HEAD | grep -qE '^plugins/igr/'; then
  exit 0   # no shipped plugin content in this commit
fi

json_v() { python3 -c 'import json,sys;print(json.load(sys.stdin)["version"])' 2>/dev/null || true; }
head_v=$(git show HEAD:"$PLUGIN" 2>/dev/null | json_v)
parent_v=$(git show HEAD^:"$PLUGIN" 2>/dev/null | json_v)
if [[ -z $head_v || -z $parent_v || $head_v != "$parent_v" ]]; then
  exit 0   # manual bump in this commit, or re-entry after our own amend
fi

if ! git diff --quiet HEAD -- "$PLUGIN"; then
  echo "hook: $PLUGIN has uncommitted edits — skipping auto-bump (bump manually)" >&2
  exit 0
fi

v=$("$(dirname "$0")/bump-version" -1 HEAD)
echo "hook: plugin version -> $v, amended into HEAD"
git commit --amend --no-edit --no-verify --only "$PLUGIN" --quiet
