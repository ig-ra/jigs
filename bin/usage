#!/usr/bin/env python3
"""Read-only Claude/Codex usage. Python standard library only."""
import argparse
from collections import Counter, defaultdict
import csv
from datetime import datetime, timedelta, timezone
import json
import os
from pathlib import Path
import re
import shlex
import sys

UTC = timezone.utc
PHASES = ('design', 'develop', 'review', 'finish', 'unknown')
WEIGHTS = {'input': 1, 'cw5m': 1.25, 'cw1h': 2, 'read': .1, 'output': 5,
           'sonnet': .6, 'haiku': .2, 'opus': 1}
PROXY_LABEL = 'IGR-14 weighted proxy, uncalibrated'
TICKET = r'[A-Za-z][A-Za-z0-9]*-\d+'
INTAKE = re.compile(r'^(?:/igr:ticket|/ticket|ticket)\s+(start|resume)\s+(' + TICKET + r')\b', re.I)
FINISH = re.compile(r'^(?:/igr:ticket|/ticket|ticket)\s+finish\s*$', re.I)


def stamp(value):
    parsed = datetime.fromisoformat(value.replace('Z', '+00:00'))
    return (parsed if parsed.tzinfo else parsed.replace(tzinfo=UTC)).astimezone(UTC)


def ticket_from_cwd(cwd):
    parts = Path(cwd or '').parts
    for i, part in enumerate(parts[:-1]):
        if part in ('.worktrees', 'worktrees'):
            for folder in parts[i + 1:]:
                match = re.match(r'^(' + TICKET + r')(?:-|$)', folder)
                if match:
                    return match[1].upper()
    return None


def text_content(value):
    if isinstance(value, str):
        return value
    if isinstance(value, list):
        return '\n'.join(b.get('text', '') for b in value if isinstance(b, dict))
    return json.dumps(value, ensure_ascii=False)


def arguments(value):
    if isinstance(value, dict):
        return value
    try:
        parsed = json.loads(value)
        return parsed if isinstance(parsed, dict) else {}
    except (ValueError, TypeError):
        return {}


def category(name, command=''):
    value = (name + ' ' + command).lower()
    for kind, pattern in (
        ('herdr', r'\bherdr\b'), ('tk', r'\btk\b|agent.estimat'),
        ('linear', r'linear|mcp__.*(?:issue|comment)'),
        ('wait', r'\b(?:sleep|wait|poll)\b'), ('github', r'\bgh\b|github'),
        ('git', r'\bgit\b'), ('test/build', r'\b(?:pytest|unittest|npm|yarn|make|go test|trunk)\b'),
        ('edit', r'edit|write|apply_patch'), ('read/search', r'read|search|grep|\brg\b|\bcat\b|\bsed\b|\bhead\b|\btail\b|\bls\b'),
        ('agent', r'agent|task|spawn')):
        if re.search(pattern, value):
            return kind
    return 'other'


def without_heredoc_bodies(command):
    """Keep shell headers; skip closed bodies with simple literal delimiters."""
    if '<<' not in command:
        return command
    lines, shell = iter(command.splitlines(keepends=True)), []
    for line in lines:
        # Retain quotes to distinguish a redirection from a quoted '<<' argument.
        lexer = shlex.shlex(line, posix=False, punctuation_chars=';&|<>')
        lexer.commenters = ''
        lexer.whitespace_split = True
        try:
            words = list(lexer)
        except ValueError:
            return None
        if line.rstrip('\r\n').endswith('\\'):
            return None  # Continued headers need a shell parser.
        bodies = []
        for index, word in enumerate(words):
            if word != '<<':
                if word.startswith('<<'):
                    return None  # Here-strings and other unsupported operators.
                continue
            if index + 1 >= len(words):
                return None
            delimiter = words[index + 1]
            strip_tabs = delimiter.startswith('-')
            if strip_tabs:
                delimiter = delimiter[1:]
                if not delimiter:
                    if index + 2 >= len(words):
                        return None
                    delimiter = words[index + 2]
            try:
                literal = shlex.split(delimiter)
            except ValueError:
                return None
            if len(literal) != 1 or not re.fullmatch(r'[A-Za-z0-9_. -]+', literal[0]):
                return None
            bodies.append((literal[0], strip_tabs))
        shell.append(line)
        for delimiter, strip_tabs in bodies:
            for body in lines:
                end = body.rstrip('\r\n')
                if (end.lstrip('\t') if strip_tabs else end) == delimiter:
                    break
            else:
                return None
    return ''.join(shell)


def step_candidates(command):
    """Literal shell arguments only; opaque code and heredoc bodies stay unknown."""
    if 'tk' not in command:
        return []
    command = without_heredoc_bodies(command)
    if command is None:
        return []
    lexer = shlex.shlex(command, posix=True, punctuation_chars=';&|<>\n')
    lexer.whitespace = ' \t\r'
    lexer.whitespace_split = True
    try:
        tokens = list(lexer)
    except ValueError:
        return []
    groups, words = [], []
    for token in tokens + [';']:
        if token and all(char in ';&|\n' for char in token):
            groups.append(words)
            words = []
        else:
            words.append(token)
    candidates = []
    for words in groups:
        if not words or Path(words[0]).name != 'tk':
            continue
        args = words[1:]
        if args[:1] == ['--cwd']:
            args = args[2:]
        if (len(args) >= 4 and args[0] == 'step' and re.fullmatch(TICKET, args[1])
                and args[2] in ('implement', 'reviews', 'checks')
                and args[3] in ('running', 'fixing', 'done', 'todo', 'fail')):
            candidates.append((args[1].upper(), args[2], args[3]))
    return candidates


def tool(identifier, name, value, source):
    args = arguments(value)
    command = args.get('command') or args.get('cmd') or ''
    # Custom code tools carry their input as source; never execute it.
    if not args and isinstance(value, str):
        command = value
    return {'id': identifier, 'name': name, 'kind': category(name, command),
            'source': source, 'result_chars': None,
            '_steps': (step_candidates(args.get('command') or args.get('cmd') or '')
                       if name.rsplit('.', 1)[-1] in ('Bash', 'exec_command') else [])}


def base(provider, session, record, path, line, cwd=None, parent=None):
    return {'provider': provider, 'session_id': session, 'timestamp': record.get('timestamp'),
            'cwd': cwd, 'parent_session_id': parent,
            'source': {'path': str(path), 'line': line},
            'record_id': record.get('uuid', record.get('ordinal'))}


def event(common, name, **fields):
    return dict(common, type='event', event=name, **fields)


def command_event(common, content):
    value = text_content(content).strip()
    # Claude's native slash-command envelope is a command, not quoted prose.
    name = re.search(r'<command-name>(.*?)</command-name>', value)
    args = re.search(r'<command-args>(.*?)</command-args>', value, re.S)
    if name and args:
        value = name[1] + ' ' + args[1]
    if FINISH.fullmatch(value):
        return event(common, 'ticket_command', action='finish', status='recorded')
    match = INTAKE.match(value)
    if match:
        return event(common, 'ticket_command', action=match[1].lower(),
                     marker_ticket=match[2].upper(), status='recorded')


def step_events(common, action, output, is_error=False, require_exit=False):
    candidates = action['_steps']
    if not candidates or not successful(output, is_error, require_exit):
        return []
    return [event(common, 'step', marker_ticket=ticket, step=line, status=status,
                  tool_id=action['id']) for ticket, line, status in candidates
            if re.search(r'(?m)^' + re.escape(f'{ticket} {line}={status}') + r'(?:\s|$)', output)]


def successful(output, is_error=False, require_exit=False):
    if is_error:
        return False
    # Codex shell output includes the process exit code. No result means no marker.
    codes = re.findall(r'(?:Process exited with code|exit[_ ]code["\s:]*|Exit code:)\s*(-?\d+)', output, re.I)
    return all(int(code) == 0 for code in codes) if codes else not require_exit


def json_lines(path, counts, provider):
    with path.open(encoding='utf-8') as stream:
        for number, line in enumerate(stream, 1):
            # Skip large Claude request blobs/history before JSON decoding.
            if provider == 'claude' and any('\"' + tag + '\"' in line[:150] for tag in
                    ('api-request', 'api-request-blob', 'api-request-shape', 'file-history-snapshot',
                     'file-history-delta', 'progress')):
                continue
            try:
                record = json.loads(line)
            except ValueError:
                counts['malformed'] += 1
                continue
            if not isinstance(record, dict):
                counts['malformed'] += 1
                continue
            yield number, record


def read_claude(path, counts):
    session = path.stem
    # Workflow agents can be nested below subagents/workflows/<workflow>/ .
    parts = path.parts
    parent = parts[parts.index('subagents') - 1] if 'subagents' in parts else None
    rows, calls, tools = [], {}, {}
    for number, record in json_lines(path, counts, 'claude'):
        common = base('claude', session, record, path, number, record.get('cwd'), parent)
        kind = record.get('type')
        message = record.get('message') or {}
        content = message.get('content', [])
        if kind == 'assistant' and message.get('id') and message.get('usage'):
            identifier = message['id']
            usage = message['usage']
            ttl = usage.get('cache_creation') or {}
            write = usage.get('cache_creation_input_tokens', 0)
            one_hour = ttl.get('ephemeral_1h_input_tokens', 0)
            call = dict(common, type='call', id=identifier, model=message.get('model'),
                        effort=record.get('effort') or record.get('perTurnEffort'),
                        native_input_tokens=usage.get('input_tokens', 0),
                        new_input_tokens=usage.get('input_tokens', 0),
                        cache_read_tokens=usage.get('cache_read_input_tokens', 0),
                        cache_write_tokens=write, cache_write_5m_tokens=write - one_hour,
                        cache_write_1h_tokens=one_hour, output_tokens=usage.get('output_tokens', 0),
                        reasoning_tokens=(usage.get('output_tokens_details') or {}).get('thinking_tokens'),
                        tools=[])
            old = calls.get(identifier)
            if old:
                counts['duplicate'] += 1
            if old is None or call['output_tokens'] >= old['output_tokens']:
                call['tools'] = old['tools'] if old else []
                # Keep the call's first timestamp for exact interval filtering.
                call['timestamp'] = old['timestamp'] if old else call['timestamp']
                calls[identifier] = call
            current = calls[identifier]
            for block in content if isinstance(content, list) else []:
                if block.get('type') != 'tool_use' or block['id'] in tools:
                    continue
                action = tool(block['id'], block['name'], block.get('input', {}), common['source'])
                tools[block['id']] = action
                current['tools'].append(action)
        elif kind == 'user':
            marker = command_event(common, content)
            if marker:
                rows.append(marker)
            for block in content if isinstance(content, list) else []:
                if block.get('type') != 'tool_result':
                    continue
                action = tools.get(block.get('tool_use_id'))
                if action:
                    output = text_content(block.get('content', ''))
                    action['result_chars'] = len(output)
                    rows.extend(step_events(common, action, output, block.get('is_error', False)))
        elif kind == 'system' and record.get('subtype') == 'compact_boundary':
            rows.append(event(common, 'compaction', details=record.get('compactMetadata')))
    rows.extend(calls.values())
    return rows


def read_codex(path, counts):
    session, cwd, model, effort, parent, role = path.stem, None, None, None, None, None
    rows, pending, tools = [], [], {}
    for number, record in json_lines(path, counts, 'codex'):
        kind, payload = record.get('type'), record.get('payload') or {}
        if kind == 'session_meta':
            session, cwd = payload['id'], payload.get('cwd')
            parent = payload.get('parent_thread_id')
            source = payload.get('source')
            role = source if isinstance(source, str) else payload.get('thread_source')
            if isinstance(source, dict):
                subagent = source.get('subagent', {})
                if isinstance(subagent, str):
                    role = subagent
                else:
                    spawn = subagent.get('thread_spawn', {})
                    role = spawn.get('agent_role') or role
                    parent = parent or spawn.get('parent_thread_id')
        elif kind == 'turn_context':
            cwd, model, effort = payload.get('cwd', cwd), payload.get('model'), payload.get('effort')
        common = base('codex', session, record, path, number, cwd, parent)
        common['native_role'] = role
        if kind == 'response_item':
            item = payload.get('type', '')
            if item in ('message', 'agent_message') and payload.get('role', payload.get('author')) == 'user':
                marker = command_event(common, payload.get('content', []))
                if marker:
                    rows.append(marker)
            elif item in ('function_call', 'custom_tool_call'):
                action = tool(payload['call_id'], payload['name'],
                              payload.get('arguments', payload.get('input', '')), common['source'])
                tools[action['id']] = action
                pending.append(action)
            elif item in ('function_call_output', 'custom_tool_call_output'):
                action = tools.get(payload.get('call_id'))
                if action:
                    output = text_content(payload.get('output', ''))
                    action['result_chars'] = len(output)
                    rows.extend(step_events(common, action, output, require_exit=True))
        if kind == 'event_msg' and payload.get('type') == 'token_count':
            limits = payload.get('rate_limits') or {}
            for window in ('primary', 'secondary'):
                snapshot = limits.get(window)
                if snapshot:
                    rows.append(event(common, 'meter', window=window, limit_id=limits.get('limit_id'),
                                      plan_type=limits.get('plan_type'), **snapshot))
        if kind == 'compacted':
            rows.append(event(common, 'compaction'))
        usage_record = payload if kind == 'token_usage_record' else (
            payload.get('latest_token_usage_record') if kind == 'compacted' else None)
        if usage_record:
            usage = usage_record['usage']
            rows.append(dict(common, type='call', id=usage_record['response_id'],
                session_id=usage_record['thread_id'], model=model, effort=effort,
                native_input_tokens=usage['input_tokens'],
                new_input_tokens=usage['input_tokens'] - usage.get('cached_input_tokens', 0),
                cache_read_tokens=usage.get('cached_input_tokens', 0),
                cache_write_tokens=usage.get('cache_write_input_tokens', 0),
                cache_write_5m_tokens=None, cache_write_1h_tokens=None,
                output_tokens=usage['output_tokens'], reasoning_tokens=usage.get('reasoning_output_tokens'),
                turn_id=usage_record.get('turn_id'), tools=pending))
            pending = []
    return rows


def normalize(rows, counts, start=None, end=None):
    unique, events = {}, {}
    for row in rows:
        if not row.get('timestamp'):
            continue
        if row['type'] != 'call':
            identity = row.get('record_id')
            if identity is None:
                identity = (row['source']['path'], row['source']['line'])
            key = (row['provider'], row['session_id'], identity, row['event'],
                   row.get('tool_id'), row.get('marker_ticket'), row.get('step'),
                   row.get('status'), row.get('action'), row.get('window'))
            if key in events:
                counts['duplicate'] += 1
            else:
                events[key] = row
            continue
        key = row['provider'], row['id']
        old = unique.get(key)
        if old:
            counts['duplicate'] += 1
            actions = {a['id']: a for a in old['tools'] + row['tools']}
            if row['output_tokens'] >= old['output_tokens']:
                row['timestamp'] = old['timestamp']
                unique[key] = row
            unique[key]['tools'] = list(actions.values())
        else:
            unique[key] = row
    intake, phases, first_commands = {}, {}, set()
    result = []
    for row in sorted(list(unique.values()) + list(events.values()), key=lambda r: (r['timestamp'], r['source']['line'])):
        scope = row['provider'], row['session_id']
        cwd_ticket = ticket_from_cwd(row.get('cwd'))
        row['ticket'] = row.get('marker_ticket') or cwd_ticket or intake.get(scope)
        row['ticket_basis'] = 'cwd' if cwd_ticket == row['ticket'] and cwd_ticket else (
            'via intake' if row['ticket'] else 'unassigned')
        if row.get('event') == 'ticket_command':
            action, ticket = row['action'], row['ticket']
            if scope not in first_commands and action == 'resume':
                result.append(event(row, 'resume_start'))
            first_commands.add(scope)
            if action in ('start', 'resume'):
                intake[scope] = ticket
            if ticket and action in ('start', 'finish'):
                phases[scope + (ticket,)] = (('design' if action == 'start' else 'finish'), row['source'])
        if row.get('event') == 'step' and row['status'] in ('running', 'fixing', 'done'):
            key = scope + (row['ticket'],)
            current = phases.get(key, ('unknown', None))[0]
            if not (current == 'finish' and row['status'] == 'done'):
                phase = 'develop' if row['step'] == 'implement' else 'review'
                phases[key] = phase, row['source']
        row['phase'], row['phase_source'] = phases.get(scope + (row['ticket'],), ('unknown', None))
        if row['type'] == 'call':
            if row['model'] == '<synthetic>':
                counts['synthetic'] += int(in_window(row, start, end))
                continue
            row['context_tokens'] = (row['native_input_tokens'] if row['provider'] == 'codex' else
                row['new_input_tokens'] + row['cache_read_tokens'] + row['cache_write_tokens'])
            kinds = {a['kind'] for a in row['tools']}
            row['kind'] = 'text' if not kinds else next(iter(kinds)) if len(kinds) == 1 else 'mixed'
            row['result_chars'] = sum(a['result_chars'] or 0 for a in row['tools'])
        result.append(row)
    # Resume events copy the already-tagged command, without changing its action.
    for row in result:
        if row.get('event') == 'resume_start':
            row['ticket'] = row['marker_ticket']
            row['ticket_basis'] = 'cwd' if ticket_from_cwd(row.get('cwd')) == row['ticket'] else 'via intake'
            row['phase'], row['phase_source'] = 'unknown', None
        for action in row.get('tools', []):
            action.pop('_steps', None)
    result = [r for r in result if in_window(r, start, end)]
    counts['unassigned'] = sum(r.get('ticket') is None for r in result)
    return result


def in_window(row, start, end):
    time = stamp(row['timestamp'])
    return (start is None or start <= time) and (end is None or time < end)


def candidates(root, start=None):
    margin = (start - timedelta(days=1)).timestamp() if start else None
    return sorted(p for p in root.rglob('*.jsonl') if margin is None or p.stat().st_mtime >= margin)


def collect(start=None, end=None, claude_root=None, codex_root=None, session=None):
    roots = {'claude': claude_root or Path.home() / '.claude/projects',
             'codex': codex_root or Path.home() / '.codex/sessions'}
    counts = Counter({name: 0 for name in ('malformed', 'duplicate', 'synthetic', 'unassigned')})
    rows = []
    for provider, root in roots.items():
        if session and session[0] != provider:
            continue
        for path in candidates(root, start):
            if session and session[1] not in str(path):
                continue
            rows.extend((read_claude if provider == 'claude' else read_codex)(path, counts))
    return normalize(rows, counts, start, end), counts


def estimates(path, start=None, end=None):
    totals = {}
    if not path.exists():
        return totals
    with path.open(newline='', encoding='utf-8') as stream:
        for row in csv.DictReader(stream, delimiter='\t'):
            if start and not (start <= stamp(row['started']) < end):
                continue
            key = row['ticket'].upper(), row['agent']
            total = totals.setdefault(key, {'estimated_rounds_low': None, 'estimated_rounds_high': None,
                                           'completed_dispatch_minutes': None})
            for column, field in (('rounds_low', 'estimated_rounds_low'), ('rounds_high', 'estimated_rounds_high'),
                                  ('actual_min', 'completed_dispatch_minutes')):
                if row.get(column):
                    total[field] = (total[field] or 0) + float(row[column])
    return totals


BUCKETS = ('new_input_tokens', 'cache_read_tokens', 'cache_write_tokens',
           'cache_write_5m_tokens', 'cache_write_1h_tokens', 'output_tokens', 'reasoning_tokens')


def percentile(values, fraction):
    if not values:
        return None
    values = sorted(values)
    position = (len(values) - 1) * fraction
    low = int(position)
    return values[low] + (values[min(low + 1, len(values) - 1)] - values[low]) * (position - low)


def model_weight(call):
    model = (call.get('model') or '').lower()
    if call['provider'] != 'claude':
        return None
    if 'fable' in model:
        return WEIGHTS['opus']
    return next((WEIGHTS[key] for key in ('sonnet', 'haiku', 'opus') if key in model), None)


def weighted(call):
    multiplier = model_weight(call)
    if multiplier is None:
        return None
    return multiplier * (call['new_input_tokens'] * WEIGHTS['input'] +
        call['cache_write_5m_tokens'] * WEIGHTS['cw5m'] + call['cache_write_1h_tokens'] * WEIGHTS['cw1h'] +
        call['cache_read_tokens'] * WEIGHTS['read'] + call['output_tokens'] * WEIGHTS['output'])


def share(numerator, denominator):
    return 100 * numerator / denominator if denominator else None


def aggregate(rows):
    calls = [r for r in rows if r['type'] == 'call']
    result = {'calls': len(calls)}
    for field in BUCKETS:
        values = [r[field] for r in calls if r.get(field) is not None]
        result[field] = sum(values) if values else (0 if field in ('new_input_tokens', 'cache_read_tokens', 'cache_write_tokens', 'output_tokens') else None)
    for label, fraction in (('median', .5), ('p90', .9), ('max', 1)):
        result['context_' + label] = percentile([r['context_tokens'] for r in calls], fraction)
    result['compactions'] = sum(r.get('event') == 'compaction' for r in rows)
    result['resume_starts'] = sum(r.get('event') == 'resume_start' for r in rows)
    result['via_intake_pct'] = share(sum(r['ticket_basis'] == 'via intake' for r in calls), len(calls))
    return result


def phase_totals(rows):
    return {phase: aggregate([r for r in rows if r['phase'] == phase]) for phase in PHASES}


def cell(value):
    if value is None:
        return 'null'
    if isinstance(value, float):
        return f'{value:.2f}'
    if isinstance(value, (list, dict)):
        return json.dumps(value, ensure_ascii=False, separators=(',', ':'))
    return str(value).replace('\t', ' ').replace('\n', ' ')


def table(headers, rows, out):
    print('\t'.join(headers), file=out)
    for row in rows:
        print('\t'.join(cell(v) for v in row), file=out)


def summary(rows, out):
    groups = {provider: [r for r in rows if r['provider'] == provider] for provider in ('claude', 'codex')}
    totals = {p: aggregate(rs) for p, rs in groups.items()}
    print('Raw token buckets; cache and reasoning subsets are not added twice.', file=out)
    table(('metric', 'claude', 'codex'), ([key, totals['claude'][key], totals['codex'][key]]
          for key in ('calls',) + BUCKETS + ('compactions', 'resume_starts', 'via_intake_pct')), out)
    details = {}
    for provider, group in groups.items():
        calls = [r for r in group if r['type'] == 'call']
        main = [r for r in calls if not r['parent_session_id']]
        weighted_total = sum(weighted(r) or 0 for r in calls)
        details[provider] = {
            'main_sessions': len({r['session_id'] for r in main}),
            'main_source_files': len({r['source']['path'] for r in main}),
            'child_source_files': len({r['source']['path'] for r in calls if r['parent_session_id']}),
            'child_sessions': len({r['session_id'] for r in calls if r['parent_session_id']}),
            'subagent_call_share_pct': share(len(calls) - len(main), len(calls)),
            'cache_read_share_of_context_pct': share(sum(r['cache_read_tokens'] for r in calls), sum(r['context_tokens'] for r in calls)),
            'main_context_median': percentile([r['context_tokens'] for r in main], .5),
            'main_context_p90': percentile([r['context_tokens'] for r in main], .9),
            'main_context_max': percentile([r['context_tokens'] for r in main], 1),
            'calls_at_400k_pct': share(sum(r['context_tokens'] >= 400000 for r in calls), len(calls)),
            'weighted_proxy': weighted_total if provider == 'claude' else None,
            'weighted_cache_read_share_pct': share(sum(r['cache_read_tokens'] * WEIGHTS['read'] *
                model_weight(r)
                for r in calls if weighted(r) is not None), weighted_total) if provider == 'claude' else None,
            'weighted_at_400k_share_pct': share(sum(weighted(r) or 0 for r in calls if r['context_tokens'] >= 400000), weighted_total) if provider == 'claude' else None,
            'unweighted_model_calls': sum(weighted(r) is None for r in calls) if provider == 'claude' else None}
    print('\nContext: main threads only. Shares: all calls including children.', file=out)
    print(PROXY_LABEL + ' (Claude only; null for Codex).', file=out)
    table(('metric', 'claude', 'codex'), ([key, details['claude'][key], details['codex'][key]]
          for key in details['claude']), out)
    for field in ('model', 'kind'):
        print('\n' + field + ' split (all calls)', file=out)
        split = []
        for provider, group in groups.items():
            calls = [r for r in group if r['type'] == 'call']
            denominator = sum(weighted(r) or 0 for r in calls)
            for label in sorted({r.get(field) or 'unknown' for r in calls}):
                selected = [r for r in calls if (r.get(field) or 'unknown') == label]
                split.append((provider, label, len(selected), share(len(selected), len(calls)),
                    share(sum(weighted(r) or 0 for r in selected), denominator) if provider == 'claude' else None))
        table(('provider', field, 'calls', 'call_share_pct', 'weighted_proxy_share_pct'), split, out)
    print('\nPhase totals (all calls; unknown included)', file=out)
    table(('provider', 'phase', 'calls') + BUCKETS,
        ([provider, phase, values['calls']] + [values[b] for b in BUCKETS]
         for provider, group in groups.items() for phase, values in phase_totals(group).items()), out)


def tickets(rows, estimate_rows, out):
    metrics = ('calls',) + BUCKETS + ('context_median', 'context_p90', 'context_max', 'compactions',
        'resume_starts', 'via_intake_pct', 'estimated_rounds_low', 'estimated_rounds_high',
        'completed_dispatch_minutes', 'phase_totals')
    headers = (['ticket'] + ['claude.' + key for key in metrics] +
               ['claude_review_minutes'] + ['codex.' + key for key in metrics])
    result = []
    # Always include unassigned, even if it is empty.
    keys = sorted({r['ticket'] for r in rows if r['ticket']}) + [None]
    for ticket in keys:
        line = [ticket or 'unassigned']
        for provider in ('claude', 'codex'):
            selected = [r for r in rows if r['ticket'] == ticket and r['provider'] == provider]
            values = aggregate(selected)
            values.update(estimate_rows.get((ticket, provider), {}))
            values['phase_totals'] = phase_totals(selected)
            line.extend(values.get(key) for key in metrics)
            if provider == 'claude':
                line.append(estimate_rows.get((ticket, 'claude-review'), {}).get('completed_dispatch_minutes'))
        result.append(line)
    table(headers, result, out)


def timeline(rows, provider, identifier, out):
    selected = [r for r in rows if r['provider'] == provider and
                (r['session_id'] == identifier or (provider == 'claude' and r['parent_session_id'] == identifier))]
    print(('Codex thread' if provider == 'codex' else 'Claude session with linked subagents') + ': ' + identifier, file=out)
    lines, previous = [], {}
    for row in sorted(selected, key=lambda r: (stamp(r['timestamp']), r['source']['line'])):
        time = stamp(row['timestamp'])
        key = row['session_id']
        gap = (time - previous[key]).total_seconds() if key in previous else None
        previous[key] = time
        detail = {'tools': row.get('tools', []), 'result_chars': row.get('result_chars')}
        if provider == 'claude':
            detail['parent_session_id'] = row['parent_session_id']
        if row.get('event') == 'meter':
            detail.update({k: row.get(k) for k in ('used_percent', 'window_minutes', 'resets_at', 'limit_id', 'plan_type')})
        if row.get('event') in ('step', 'ticket_command'):
            detail.update({k: row.get(k) for k in ('action', 'step', 'status')})
        lines.append([row['timestamp'], row['session_id'], row['ticket'], row['phase'],
            row.get('event', 'call'), row.get('model'), row.get('context_tokens'), gap,
            detail, row['source']])
    table(('timestamp', 'session', 'ticket', 'phase', 'record', 'model', 'context',
           'idle_gap_seconds', 'detail', 'source'), lines, out)


def render(command, rows, out, estimate_rows=None, session=None):
    if command == 'summary':
        summary(rows, out)
    elif command == 'tickets':
        tickets(rows, estimate_rows or {}, out)
    elif command == 'session':
        timeline(rows, *session, out)
    else:
        for row in rows:
            print(json.dumps(row, ensure_ascii=False, separators=(',', ':')), file=out)


def parser():
    cli = argparse.ArgumentParser(description='Read-only raw token usage for Claude and Codex flat plans; UTC dates, END exclusive.')
    commands = cli.add_subparsers(dest='command', required=True)
    for name in ('summary', 'tickets', 'export'):
        command = commands.add_parser(name, help={'summary': 'IGR-14 summary and phase totals',
            'tickets': 'Ticket rows, both providers; resume starts are not proven handoffs',
            'export': 'Normalized call/event JSONL; diagnostics on stderr'}[name])
        command.add_argument('start', type=stamp, metavar='START')
        command.add_argument('end', type=stamp, metavar='END')
    command = commands.add_parser('session', help='Claude session with linked subagents, or Codex thread (own calls only)')
    command.add_argument('id', metavar='claude:ID|codex:ID')
    return cli


def main():
    cli = parser()
    args = cli.parse_args()
    session = None
    if args.command == 'session':
        provider, separator, identifier = args.id.partition(':')
        if not separator or provider not in ('claude', 'codex') or not identifier:
            cli.error('session requires claude:ID or codex:ID')
        session = provider, identifier
        start = end = None
    else:
        start, end = args.start, args.end
        if start >= end:
            cli.error('START must be before END (UTC, end exclusive)')
    rows, counts = collect(start, end, session=session)
    estimate_rows = estimates(Path(os.environ.get('AGENT_ESTIMATES') or Path.home() / '.claude/agent-estimates.tsv'), start, end) if args.command == 'tickets' else None
    if args.command in ('summary', 'tickets'):
        print('UTC [' + start.isoformat() + ', ' + end.isoformat() + ')')
    render(args.command, rows, sys.stdout, estimate_rows, session)
    print('diagnostics: ' + ' '.join(f'{key}={counts[key]}' for key in
          ('malformed', 'duplicate', 'synthetic', 'unassigned')), file=sys.stderr)


if __name__ == '__main__':
    main()
